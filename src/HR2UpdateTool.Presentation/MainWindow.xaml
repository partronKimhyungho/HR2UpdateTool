<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HR2UpdateTool.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HR2UpdateTool.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="HR2UpdateTool.Presentation">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel
        x:Name="RootGrid"
        Spacing="16"
        Loaded="RootGrid_Loaded"
        Padding="24, 16, 24, 32">

        <Image 
            HorizontalAlignment="Left"
            Source="/Assets/logo_hybe_white.png"
            Stretch="Uniform"
            Height="40"/>

        <Grid
            HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="COM Port"
                FontWeight="Bold"/>

            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Select"
                Margin="0, 0, 16, 0"
                ItemsSource="{x:Bind ViewModel.AvailablePorts, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedPort, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.IsNotConnected, Mode=OneWay}">
            </ComboBox>

            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ToggleConnectCommand}"
                Content="{x:Bind ViewModel.ConnectButtonText, Mode=OneWay}"/>
        </Grid>

        <Grid
            HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="펌웨어 파일"
                FontWeight="Bold"/>

            <ScrollViewer Grid.Column="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"/>
            </ScrollViewer>

            <Button
                Grid.Column="2"
                Width="16"
                Height="16"
                Visibility="{x:Bind ViewModel.ClearButtonVisible, Mode=OneWay}"
                Padding="0"
                Command="{x:Bind ViewModel.ClearFilePathCommand, Mode=OneWay}"
                Style="{StaticResource TransparentButtonStyle}"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Image
                    Source="{StaticResource IconXCircle}"
                    IsHitTestVisible="False" />
            </Button>

            <Button
                Command="{x:Bind ViewModel.SelectFileCommand, Mode=OneWay}"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Content="+ 파일 불러오기"/>
        </Grid>

        <Grid
            HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                HorizontalAlignment="Left"
                Content="업데이트 시작"
                IsEnabled="{x:Bind ViewModel.UpdateEnable, Mode=OneWay}"
                Command="{x:Bind ViewModel.StartFirmwareUpdateCommand, Mode=OneWay}"/>
        </Grid>

        <Grid
            HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Height="16">
                <Border Background="#D9D9D9"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.ProgressGridLength, Mode=OneWay}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border 
                        Grid.Column="0"
                        Background="{StaticResource HyperLemon}" />
                </Grid>
            </Grid>
        </Grid>
    </StackPanel>
</Window>
